# --- Arc public testnet deploy (§9). The human fills these from Arc docs / faucet.circle.com. ---
# The deploy script reverts naming any missing var — it never falls back to a placeholder.
ARC_TESTNET_RPC=            # Arc public testnet RPC URL
ARC_TESTNET_CHAIN_ID=       # Arc testnet chain id
ARC_USDC_ADDRESS=           # real testnet USDC on Arc (faucet.circle.com / Arc docs)
ARC_EXPLORER_URL=           # Arc testnet explorer base (for verification links), if available
DEPLOYER_PRIVATE_KEY=       # funded deployer key (TESTNET ONLY)

# Optional: auditor address for the vault router (defaults to the deployer if unset).
ARC_AUDITOR_ADDRESS=

# Optional overrides (sensible defaults applied if unset)
LEDGER_WITHDRAW_WINDOW=      # seconds; default 3600
ROUTER_BATCH_WINDOW=         # seconds; default 3600
